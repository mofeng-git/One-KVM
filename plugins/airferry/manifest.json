{
  "abi": 1,
  "id": "airferry",
  "name": "AirFerry",
  "version": "0.2.9",
  "author": "SilentWind",
  "description": {
    "en-US": "Receive files from QR codes in a native MJPEG capture stream.",
    "zh-CN": "从原生 MJPEG 采集画面中的二维码接收文件。"
  },
  "menu": "console_toolbar",
  "capabilities": [
    "video",
    "images"
  ],
  "config_schema": [],
  "status_fields": [
    {
      "key": "receiving",
      "label": {
        "en-US": "Receiving",
        "zh-CN": "正在接收"
      }
    },
    {
      "key": "capture",
      "label": {
        "en-US": "Capture",
        "zh-CN": "采集状态"
      },
      "value_labels": {
        "ready": {
          "en-US": "Ready",
          "zh-CN": "可以接收"
        },
        "mjpeg_required": {
          "en-US": "Switch to MJPEG mode",
          "zh-CN": "请切换到 MJPEG 模式"
        },
        "native_jpeg_required": {
          "en-US": "Native MJPEG capture required",
          "zh-CN": "采集设备需输出原生 MJPEG"
        },
        "capture_unavailable": {
          "en-US": "Capture unavailable",
          "zh-CN": "采集画面不可用"
        }
      }
    },
    {
      "key": "event",
      "label": {
        "en-US": "Receiver status",
        "zh-CN": "接收状态"
      }
    },
    {
      "key": "last_saved",
      "label": {
        "en-US": "Last received file",
        "zh-CN": "最近收到的文件"
      }
    }
  ],
  "actions": [
    {
      "id": "start_receive",
      "label": {
        "en-US": "Start receiving",
        "zh-CN": "开始接收"
      },
      "when_status": [
        {
          "key": "receiving",
          "equals": false
        },
        {
          "key": "capture",
          "equals": "ready"
        }
      ]
    },
    {
      "id": "stop_receive",
      "label": {
        "en-US": "Stop receiving",
        "zh-CN": "停止接收"
      },
      "when_status": [
        {
          "key": "receiving",
          "equals": true
        }
      ]
    }
  ],
  "files": true,
  "default_enabled": true,
  "toolbar_icon": "scan_line",
  "files_in_images": true
}
